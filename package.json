{
	"name": "n8n-nodes-pagetranslate",
	"version": "0.1.0",
	"description": "Translate PDF, scanned PDF, DOCX, EPUB and image documents with PageTranslate, preserving layout",
	"license": "MIT",
	"homepage": "https://pagetranslate.ai",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"n8n-community-node-package",
		"pagetranslate",
		"pdf-translator",
		"document-translation"
	],
	"author": {
		"name": "Caravaca Labs",
		"email": "support@pagetranslate.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Caravaca-Labs/n8n-nodes-pagetranslate.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PageTranslateApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PageTranslate/PageTranslate.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
